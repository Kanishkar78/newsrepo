# Server Configuration
PORT=3000

# PostgreSQL Credentials (replace with your local or cloud PostgreSQL credentials)
PGUSER=postgres
PGPASSWORD=your_password_here
PGHOST=localhost
PGPORT=5432
PGDATABASE=newsdb

# Complete Database URL (optional, alternative to separate PG* variables)
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/newsdb
