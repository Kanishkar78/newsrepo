# ==============================================================================
# Stage 1: Build the React SPA Frontend
# ==============================================================================
FROM node:20-alpine AS frontend-builder
WORKDIR /app/client

# Install frontend dependencies
COPY client/package*.json ./
RUN npm install

# Build production bundle with Vite
COPY client/ ./
RUN npm run build

# ==============================================================================
# Stage 2: Production Backend Container with PostgreSQL Client
# ==============================================================================
FROM node:20-alpine
WORKDIR /app

# Set production environment
ENV NODE_ENV=production \
    PORT=3000 \
    PGUSER=postgres \
    PGPASSWORD=postgres \
    PGHOST=news-postgres \
    PGPORT=5432 \
    PGDATABASE=newsdb

# Install backend dependencies
COPY package*.json ./
RUN npm install --omit=dev

# Copy backend source files & database schema
COPY server.js ./
COPY db/ ./db/
COPY services/ ./services/
COPY public/ ./public/

# Copy compiled React frontend into client/dist so server.js serves SPA
COPY --from=frontend-builder /app/client/dist ./client/dist

# Expose API and web application port
EXPOSE 3000

# Start Express server
CMD ["node", "server.js"]
